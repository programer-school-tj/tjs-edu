# Dedicated PostgreSQL database for TJS Edu (do not reuse ProgramerTJ credentials).
DATABASE_URL=
# Generate a random secret of at least 32 characters.
SESSION_SECRET=

# Required by docker compose; use a random hexadecimal password.
POSTGRES_PASSWORD=

# Optional: transactional email for password-reset codes (Resend).
# Verify the sender domain in Resend before using a real address.
RESEND_API_KEY=
RESEND_FROM="TJS Edu <noreply@your-verified-domain.tld>"

# Local API server port (default 3001)
API_PORT=3001
